                "svgcontent": "<svg width=\"880\" height=\"460\" xmlns=\"http://www.w3.org/2000/svg\"><g><title>Layer 1</title><text x=\"30\" y=\"40\" font-size=\"24\" fill=\"#172235\">Switch Toggle regression #2554</text><text x=\"30\" y=\"95\" font-size=\"18\" fill=\"#172235\">Initial false \u2014 two switches share one internal tag</text><g id=\"HXT_switch_0_0\" type=\"svg-ext-html_switch\"><rect x=\"50\" y=\"120\" width=\"130\" height=\"42\" stroke-width=\"0\" fill=\"none\"/><foreignObject x=\"50\" y=\"120\" width=\"130\" height=\"42\"><div xmlns=\"http://www.w3.org/1999/xhtml\" id=\"T-HXT_0_0\" style=\"width:124px;height:36px\"></div></foreignObject></g><g id=\"HXT_switch_0_1\" type=\"svg-ext-html_switch\"><rect x=\"260\" y=\"120\" width=\"130\" height=\"42\" stroke-width=\"0\" fill=\"none\"/><foreignObject x=\"260\" y=\"120\" width=\"130\" height=\"42\"><div xmlns=\"http://www.w3.org/1999/xhtml\" id=\"T-HXT_0_1\" style=\"width:124px;height:36px\"></div></foreignObject></g><text x=\"500\" y=\"147\" font-size=\"18\" fill=\"#172235\">Tag value:</text><g id=\"VAL_tag_0\" type=\"svg-ext-value\"><text x=\"610\" y=\"147\" font-size=\"24\" fill=\"#0c6cbb\">?</text></g><text x=\"30\" y=\"265\" font-size=\"18\" fill=\"#172235\">Initial true \u2014 two switches share one internal tag</text><g id=\"HXT_switch_1_0\" type=\"svg-ext-html_switch\"><rect x=\"50\" y=\"290\" width=\"130\" height=\"42\" stroke-width=\"0\" fill=\"none\"/><foreignObject x=\"50\" y=\"290\" width=\"130\" height=\"42\"><div xmlns=\"http://www.w3.org/1999/xhtml\" id=\"T-HXT_1_0\" style=\"width:124px;height:36px\"></div></foreignObject></g><g id=\"HXT_switch_1_1\" type=\"svg-ext-html_switch\"><rect x=\"260\" y=\"290\" width=\"130\" height=\"42\" stroke-width=\"0\" fill=\"none\"/><foreignObject x=\"260\" y=\"290\" width=\"130\" height=\"42\"><div xmlns=\"http://www.w3.org/1999/xhtml\" id=\"T-HXT_1_1\" style=\"width:124px;height:36px\"></div></foreignObject></g><text x=\"500\" y=\"317\" font-size=\"18\" f