                "variables": {},
                "svgcontent": "<svg width=\"920\" height=\"510\" xmlns=\"http://www.w3.org/2000/svg\"><g><title>Layer 1</title><text x=\"30\" y=\"45\" font-size=\"24\" fill=\"#172235\">HMI script authorization #2615</text><text x=\"30\" y=\"78\" font-size=\"16\" fill=\"#172235\">Internal tags only. Operator can execute; Viewer can only observe.</text><g id=\"HXB_SERVER\" type=\"svg-ext-html_button\"><rect x=\"35\" y=\"125\" width=\"220\" height=\"45\" fill=\"none\" stroke-width=\"0\"/><foreignObject x=\"35\" y=\"125\" width=\"220\" height=\"45\"><button xmlns=\"http://www.w3.org/1999/xhtml\" id=\"B-HXB_SERVER\" style=\"width:210px;height:40px\">Run SERVER</button></foreignObject></g><text x=\"300\" y=\"155\" font-size=\"18\" fill=\"#172235\">server-result:</text><g id=\"VAL_SERVER\" type=\"svg-ext-value\"><text x=\"490\" y=\"155\" font-size=\"24\" fill=\"#0c6cbb\">?</text></g><g id=\"HXB_CLIENT\" type=\"svg-ext-html_button\"><rect x=\"35\" y=\"235\" width=\"220\" height=\"45\" fill=\"none\" stroke-width=\"0\"/><foreignObject x=\"35\" y=\"235\" width=\"220\" height=\"45\"><button xmlns=\"http://www.w3.org/1999/xhtml\" id=\"B-HXB_CLIENT\" style=\"width:210px;height:40px\">Run CLIENT</button></foreignObject></g><text x=\"300\" y=\"265\" font-size=\"18\" fill=\"#172235\">client-result:</text><g id=\"VAL_CLIENT\" type=\"svg-ext-value\"><text x=\"490\" y=\"265\" font-size=\"24\" fill=\"#0c6cbb\">?</text></g><g id=\"HXB_DENIED\" type=\"svg-ext-html_button\"><rect x=\"35\" y=\"350\" width=\"220\" height=\"45\" fill=\"none\" stroke-width=\"0\"/><foreignObject x=\"35\" y=\"350\" width=\"220\" height=\"45\"><button xmlns=\"http://www.w3.org/1999/xhtml\" id=\"B-HXB_DENIED\" style=\"width:210px;height:40px\">Different script role</button></foreignObject></g><text x=\"300\" y=\"380\" font-size=\"16\" fill=\"#172235\">Operator button access does not grant Engineer script access.</text><text x=\"300\" y=\"440\" font-size=\"18\" fill=\"#172235\">denied-result:</text><g id=\"VAL_DENIED\" type=\"svg-ext-value\"><text x=\"490\" y=\"440\" font-size=\"24\" fill=\"#0c6cbb\">?</text></g></g></svg>"
            }
